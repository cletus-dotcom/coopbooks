# --- Local development (individual vars) ---
DB_USER=postgres
DB_PASS=password
DB_IP=127.0.0.1
DB_PORT=5432
DB_NAME=coop_accounting
PLATFORM_DB_NAME=coop_platform
SECRET_KEY=coop_cda_secret_key_change_in_production
PORT=8040
FLASK_ENV=development

# --- Vercel + Supabase (IMPORTANT) ---
#
# Do NOT use the direct Supabase URL (db.xxxx.supabase.co:5432) on Vercel.
# It fails with "Cannot assign requested address" (IPv6 from serverless).
#
# In Supabase: Project Settings → Database → Connection string
#   Mode: Transaction
#   Port: 6543
# Copy that URI into DATABASE_POOLER_URL on Vercel:
#
# DATABASE_POOLER_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Optional: keep DATABASE_URL for local direct connection; Vercel uses DATABASE_POOLER_URL first.
#
# Also set on Vercel:
#   SECRET_KEY=long-random-string
#   FLASK_ENV=production
