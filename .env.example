# --- Local development (individual vars) ---
DB_USER=postgres
DB_PASS=password
DB_IP=127.0.0.1
DB_PORT=5432
DB_NAME=coop_accounting
PLATFORM_DB_NAME=coop_platform
SECRET_KEY=coop_cda_secret_key_change_in_production
PORT=8040
FLASK_ENV=development

# --- Vercel / hosted Postgres (use ONE of these approaches) ---
#
# Option A — single connection string (Supabase, Neon, Vercel Postgres):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
#   Platform + tenant tables can share one database on hosted providers.
#
# Option B — separate platform + tenant databases on the same host:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/coop_accounting?sslmode=require
#   PLATFORM_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/coop_platform?sslmode=require
#
# Option C — individual vars (also works on Vercel):
#   DB_HOST=your-db-host.supabase.co
#   DB_USER=postgres
#   DB_PASS=your-password
#   DB_PORT=5432
#   DB_NAME=coop_accounting
#   PLATFORM_DB_NAME=coop_platform
#
# Vercel also sets VERCEL=1 automatically; do not commit real secrets.
